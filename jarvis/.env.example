# Copia de ejemplo. El archivo real se llama ".env" y lo crea "Encender Jarvis.bat".
# NUNCA subas el archivo .env a internet.

# Tu clave de la API de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=pega_aqui_tu_clave

# Modelo de Gemini que usa Jarvis (opcional)
GEMINI_MODEL=gemini-3.8-flash

# Puerto donde corre Jarvis (opcional)
PORT=3000
